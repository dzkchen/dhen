{
	"schemaVersion": 1,
	"id": "dhen",
	"version": "${version}",
	"name": "Dhen",
	"description": "A modular Hypixel SkyBlock client mod for Minecraft.",
	"authors": [
		"dzkchen"
	],
	"contact": {
		"homepage": "https://github.com/dzkchen/dhen",
		"sources": "https://github.com/dzkchen/dhen"
	},
	"license": "MIT",
	"icon": "assets/dhen/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			{
				"value": "io.github.dzkchen.dhen.Dhen",
				"adapter": "kotlin"
			}
		],
		"modmenu": [
			{
				"value": "io.github.dzkchen.dhen.gui.ModMenuEntry",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"dhen.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": ">=${fabric_api_floor}",
		"fabric-language-kotlin": ">=${fabric_kotlin_floor}"
	},
	"breaks": {
		"modmenu": "<${modmenu_version}"
	}
}